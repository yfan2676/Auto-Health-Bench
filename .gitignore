# =============================================================================
# Auto-Health-Bench — research log
# Convention: high-level docs + code + small report files are committed.
# Raw data and large generated artifacts are git-ignored (per experiment).
# =============================================================================

# ---- Per-experiment RAW DATA: never commit ---------------------------------
# Re-download or regenerate via each experiment's data/README.md. Keep the README.
experiments/*/data/*
!experiments/*/data/README.md

# ---- Per-experiment RAW / BULK / INTERMEDIATE results: not committed --------
# Regenerable from code + data. Report-style outputs (write-ups, score tables, and
# rendered reports incl. PDFs / HTML / figures) are intentionally NOT listed here,
# so they sync. Add new bulk/intermediate patterns here as experiments produce them.
experiments/*/results/**/prompt_*.txt
experiments/*/results/**/resp_*.txt
experiments/*/results/**/grade_*.json
experiments/*/results/**/rubric_*.json
experiments/*/results/**/dep_*.json
experiments/*/results/**/cases_all.json
experiments/*/results/**/shortlist.jsonl
experiments/*/results/**/responses/*
experiments/*/results/**/grades.jsonl
# counterfactual-mutation: bulk per-item files carry verbatim HealthBench prompt/rubric text.
# Git-ignored by default to keep the repo small, not for licensing — a committed SUBSET is allowed
# (only the full original dataset must stay out). report.md / metrics.json / noise_floor.json sync.
experiments/*/results/**/footprint/*
experiments/*/results/**/footprint_*/*
experiments/*/results/**/answers/*
experiments/*/results/**/answers_*/*
experiments/*/results/**/sweep/*
experiments/*/results/**/sweep_grades/*
experiments/*/results/**/sweep_grades_*/*
experiments/*/results/**/edits_override/*
# Aggregated viewer bundle embeds verbatim prompt/rubric/judge text — git-ignored by default
# (large; per-experiment opt-in). viewer/index.html and src/build_viewer.py are code and DO sync.
experiments/*/viewer/data.json
# OPT-IN: publish the counterfactual-mutation viewer bundle so the static viewer renders on a
# fresh clone. It embeds a SUBSET of verbatim HealthBench text, which the repo policy allows
# (only the full original dataset must stay out) — the general rule above guards every other bundle.
!experiments/counterfactual-mutation/viewer/data.json
*.log

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.python-version
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ---- LaTeX build artifacts (latex/ keeps sources only) ---------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# ---- Env / secrets (API keys for model eval) -------------------------------
.env
.env.*
!.env.example

# ---- Local Claude settings -------------------------------------------------
.claude/settings.local.json

# ---- OS / editor -----------------------------------------------------------
.DS_Store
.vscode/
.idea/
